<Window x:Class="Postinstall.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Postinstall — programy dla Windows" Icon="Resources/Postinstall.ico" Width="1210" Height="790" MinWidth="1020" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#F5F7F9" FontFamily="Segoe UI"
        Foreground="{StaticResource Ink}" Loaded="WindowLoaded" Closing="WindowClosing" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#F0F3F5" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Background" Value="#E8F5ED" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="working"><Setter Property="Background" Value="#E8F1FC" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Background" Value="#FCEAED" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning"><Setter Property="Background" Value="#FFF3DE" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#70808B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="success"><Setter Property="Foreground" Value="#25815A" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="working"><Setter Property="Foreground" Value="#2869B6" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="error"><Setter Property="Foreground" Value="#B43D44" /></DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="warning"><Setter Property="Foreground" Value="#A5701E" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#D6DFE3" BorderThickness="1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="202" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#122E39" Grid.RowSpan="2">
                <Grid Margin="18,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="8,29,0,30">
                        <Border Width="34" Height="34" Background="#31B99C" CornerRadius="9" Margin="0,0,10,0">
                            <Path Data="M 10,7 L 19,7 C 25,7 25,17 19,17 L 13,17 L 13,26 L 10,26 Z M 13,10 L 13,14 L 19,14 C 21,14 21,10 19,10 Z" Fill="#102E38" />
                        </Border>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Postinstall" FontSize="19" FontWeight="SemiBold" Foreground="White" /><TextBlock Text="TWÓJ ZESTAW PROGRAMÓW" FontSize="8" Foreground="#89A7B0" Margin="0,3,0,0" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="PRZESTRZEŃ ROBOCZA" Foreground="#6F929F" FontSize="9" FontWeight="SemiBold" Margin="12,2,0,12" />
                        <Button Style="{StaticResource NavButton}" Background="#214551" Foreground="White" Click="CatalogClicked" AutomationProperties.Name="Katalog programów">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Katalog programów" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="0,6,0,0" Click="LogsClicked" AutomationProperties.Name="Dziennik sesji">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Dziennik sesji" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" Margin="0,6,0,0" Click="HelpClicked" AutomationProperties.Name="Jak to działa">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" /><TextBlock Text="Jak to działa" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="3" Background="#1A3B47" BorderBrush="#2B4F5B" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,14,0,22">
                        <StackPanel><TextBlock Text="Wszystko w jednym miejscu" FontSize="11" FontWeight="SemiBold" Foreground="#E2EFF1" TextWrapping="Wrap" />
                            <TextBlock Text="Wybierz programy. Zainstaluj.&#x0A;Zacznij pracować." FontSize="11" Foreground="#94B2BD" LineHeight="19" Margin="0,7,0,17" />
                            <Border Background="#244C57" CornerRadius="4" Padding="7,5" HorizontalAlignment="Left"><TextBlock Text="WINDOWS 10 / 11" FontSize="8" Foreground="#96D3C4" FontWeight="SemiBold" /></Border>
                            <TextBlock Text="Postinstall 1.1.0" FontSize="9" Foreground="#6F929F" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#E7EDF0" BorderThickness="0,0,0,1">
                    <Grid Margin="28,0,8,0"><TextBlock Text="Programy / Katalog" FontSize="11" Foreground="#84949C" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Width="40" Style="{StaticResource GhostButton}" Padding="0" Click="MinimizeClicked" AutomationProperties.Name="Minimalizuj"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" /></Button>
                            <Button Width="40" Style="{StaticResource GhostButton}" Padding="0" Click="MaximizeClicked" AutomationProperties.Name="Maksymalizuj"><TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" /></Button>
                            <Button Width="40" Style="{StaticResource GhostButton}" Padding="0" Click="CloseClicked" AutomationProperties.Name="Zamknij"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" /></Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="28,17,28,14"><Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Przygotuj komputer do pracy." FontSize="27" FontWeight="SemiBold" /><TextBlock Text="Wybierz swój zestaw. Pobierz najnowsze wersje. Resztą zajmie się Postinstall." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" /></StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0" Click="RefreshClicked" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="Odśwież stan" Padding="12,9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" /><TextBlock Text="Odśwież stan" /></StackPanel></Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="9" BorderBrush="#E2E9ED" BorderThickness="1" Padding="17,13" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Programs.Count}" FontSize="25" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="programy w katalogu" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Twój codzienny zestaw" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel></StackPanel></Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="9" BorderBrush="#E2E9ED" BorderThickness="1" Padding="17,13" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding InstalledCount}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="już zainstalowanych" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Wykryte na tym komputerze" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel></StackPanel></Border>
                        <Border Grid.Column="2" Background="#EAF5F1" CornerRadius="9" BorderBrush="#D8EAE3" BorderThickness="1" Padding="17,13"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedCount}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,12,0" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="wybranych przez Ciebie" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="Gotowe do działania" FontSize="10" Foreground="#6B8C81" Margin="0,3,0,0" /></StackPanel></StackPanel></Border>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
                        <Border Background="White" CornerRadius="7" BorderBrush="#DDE5E9" BorderThickness="1" Height="37" Margin="0,0,10,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#8A9BA4" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" Padding="0,0,8,0" AutomationProperties.Name="Szukaj programu" />
                                <TextBlock Grid.Column="1" Text="Szukaj programu…" Foreground="#99A7AD" VerticalAlignment="Center" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            </Grid>
                        </Border>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,0" VerticalContentAlignment="Center" FontSize="12" Padding="9,6" AutomationProperties.Name="Kategoria" />
                        <ComboBox Grid.Column="2" SelectedValue="{Binding Filter}" SelectedValuePath="Content" VerticalContentAlignment="Center" FontSize="12" Padding="9,6" AutomationProperties.Name="Filtr stanu">
                            <ComboBoxItem Content="Wszystkie" /><ComboBoxItem Content="Zainstalowane" /><ComboBoxItem Content="Do instalacji" /><ComboBoxItem Content="Zaznaczone" />
                        </ComboBox>
                    </Grid>
                    <Border Grid.Row="3" Background="White" CornerRadius="9" BorderBrush="#E1E8EC" BorderThickness="1">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="39" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>
                            <Border Background="#FAFBFC" BorderBrush="#E8EDF0" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0">
                                <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="94" /><ColumnDefinition Width="132" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="SelectVisibleBox" Click="SelectVisibleClicked" IsEnabled="{Binding CanOperate}" ToolTip="Zaznacz / odznacz widoczne programy" AutomationProperties.Name="Zaznacz widoczne programy" />
                                    <TextBlock Grid.Column="1" Text="PROGRAM" FontSize="9" FontWeight="SemiBold" Foreground="#8B9BA4" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="KATEGORIA" FontSize="9" FontWeight="SemiBold" Foreground="#8B9BA4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="STAN NA KOMPUTERZE" FontSize="9" FontWeight="SemiBold" Foreground="#8B9BA4" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="DZIAŁANIA" FontSize="9" FontWeight="SemiBold" Foreground="#8B9BA4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,9,0" />
                                </Grid>
                            </Border>
                            <ListBox x:Name="ProgramList" Grid.Row="1" ItemsSource="{Binding VisiblePrograms}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="14,6">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#F2F9F6" /></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F7FAFB" /></Trigger></Style.Triggers></Style></Border.Style>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="94" /><ColumnDefinition Width="132" /><ColumnDefinition Width="138" /></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Definition.Name}" />
                                            <Grid Grid.Column="1" Margin="4,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="43" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Width="34" Height="34" Background="{Binding Definition.IconBackground}" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Definition.Monogram}" Foreground="{Binding Definition.Color}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Definition.Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Definition.Description}" FontSize="10" Foreground="#7A8B96" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Definition.Description}" /></StackPanel>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Definition.Category}" Foreground="#7A8B96" FontSize="10" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding Detail}"><Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" /></Border><TextBlock Text="{Binding Version}" Foreground="#94A0A8" FontSize="9" Margin="2,3,0,0" /></StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button Content="{Binding InstallLabel}" Click="InstallOneClicked" Tag="{Binding}" Padding="8,7" FontSize="10" Foreground="{StaticResource Accent}" BorderBrush="#D8E9E3" ToolTip="Zainstaluj lub zaktualizuj program" AutomationProperties.Name="{Binding InstallLabel}" />
                                                <Button Click="UninstallOneClicked" Tag="{Binding}" IsEnabled="{Binding IsInstalled}" Style="{StaticResource GhostButton}" Padding="5,6" Margin="3,0,0,0" ToolTip="Odinstaluj program" AutomationProperties.Name="Odinstaluj program"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#84949C" /></Button>
                                                <Button Click="MoreClicked" Tag="{Binding}" Style="{StaticResource GhostButton}" Padding="3,6" ToolTip="Szczegóły i strona programu" AutomationProperties.Name="Więcej opcji"><TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#84949C" /></Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Nie znaleziono programów" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Zmień wyszukiwanie lub filtry." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                            <Grid Grid.Row="2" Margin="14,0"><TextBlock Text="{Binding CatalogLabel}" FontSize="10" Foreground="#85969F" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding CanOperate}">
                                    <Button Content="Zainstaluj wszystkie" Style="{StaticResource GhostButton}" Padding="8,6" FontSize="10" Foreground="{StaticResource Accent}" Click="InstallAllClicked" />
                                    <Button Content="Odinstaluj wszystkie" Style="{StaticResource GhostButton}" Padding="8,6" FontSize="10" Foreground="#AB5660" Click="UninstallAllClicked" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="4" Margin="0,10,0,9"><TextBlock Text="{Binding SelectionLabel}" FontSize="11" Foreground="#70808B" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Odznacz" Style="{StaticResource GhostButton}" Click="ClearSelectionClicked" IsEnabled="{Binding CanOperate}" Padding="11,10" Foreground="#82929C" FontSize="11" />
                            <Button Content="Odinstaluj wybrane" Style="{StaticResource DangerButton}" Click="UninstallSelectedClicked" IsEnabled="{Binding CanUninstallSelected}" Margin="9,0,9,0" />
                            <Button x:Name="InstallSelectedButton" Style="{StaticResource PrimaryButton}" Click="InstallSelectedClicked" IsEnabled="{Binding CanInstallSelected}" AutomationProperties.Name="Zainstaluj wybrane"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" /><TextBlock Text="Zainstaluj wybrane" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="5">
                        <Border Background="White" CornerRadius="8" BorderBrush="#E1E8EC" BorderThickness="1" Padding="14,11">
                            <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Activity}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding OperationDetail}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding OperationDetail}" /></StackPanel>
                                <Button Grid.Column="1" Content="Zatrzymaj po bieżącym" Padding="9,6" Margin="12,0,0,0" FontSize="10" IsEnabled="{Binding CanStop}" Visibility="{Binding QueueActive, Converter={StaticResource BoolVisibility}}" Click="StopClicked" />
                            </Grid>
                            <ProgressBar Height="3" Margin="0,10,0,0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" Foreground="{StaticResource Accent}" Background="#E9EFF1" BorderThickness="0" />
                            </StackPanel>
                        </Border>
                        <Expander x:Name="LogExpander" Header="Dziennik sesji" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0">
                            <Border Background="#122B36" CornerRadius="5" Padding="10" Margin="0,5,0,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#B7D9CD" BorderThickness="0" FontFamily="Consolas" FontSize="10" Height="106" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <Button Grid.Row="1" Content="Otwórz pełny dziennik" Click="OpenLogClicked" Style="{StaticResource GhostButton}" Foreground="#C5E2D8" Padding="4,6" HorizontalAlignment="Right" FontSize="10" />
                            </Grid></Border>
                        </Expander>
                        <Grid Margin="0,3,0,0"><TextBlock Text="{Binding SystemStatus}" FontSize="9" Foreground="#8C9BA3" /><TextBlock Text="{Binding QueueLabel}" FontSize="9" Foreground="#8C9BA3" HorizontalAlignment="Right" /></Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
